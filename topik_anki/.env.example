# Copy to `.env` and fill in what you use. `.env` is gitignored and loaded
# automatically by `topik-anki`; never commit real keys.

# Anthropic — required for the default LLM provider.
ANTHROPIC_API_KEY=

# OpenAI-compatible providers (LLM and/or TTS). Leave the key empty for
# local servers that don't require auth (Ollama, LM Studio, Kokoro, ...).
#OPENAI_API_KEY=
#OPENAI_BASE_URL=http://localhost:11434/v1
